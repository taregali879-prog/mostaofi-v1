{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.test.json"
      }
    ]
  },
  "testEnvironment": "node",
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/main.ts"
  ],
  "coverageReporters": [
    "text",
    "json-summary",
    "lcov"
  ],
  "coverageThreshold": {
    "global": {
      "statements": 80,
      "functions": 75,
      "branches": 60,
      "lines": 90
    }
  }
}
