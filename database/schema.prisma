generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContractorStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  TRIAL
  APPROVED
  SUSPENDED
  REJECTED
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum DocumentStatus {
  DRAFT
  UPLOADED
  APPROVED
  REJECTED
}

enum BoqStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  SUPERSEDED
}

model User {
  id           String       @id @db.Uuid
  email        String       @unique
  displayName  String
  passwordHash String       @map("password_hash")
  createdAt    DateTime     @default(now()) @map("created_at")
  memberships  Membership[]
  auditEvents  AuditEvent[] @relation("ActorAuditEvents")
  sessions     AuthSession[]
  @@map("users")
}


model AuthSession {
  id               String   @id @db.Uuid
  userId           String   @db.Uuid @map("user_id")
  organizationId   String   @db.Uuid @map("organization_id")
  refreshTokenHash String   @map("refresh_token_hash")
  expiresAt        DateTime @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime @default(now()) @map("created_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, organizationId])
  @@map("auth_sessions")
}

model Organization {
  id                String             @id @db.Uuid
  name              String
  createdAt         DateTime           @default(now()) @map("created_at")
  memberships       Membership[]
  contractorProfile ContractorProfile?
  projects          Project[]
  documents         Document[]
  boqs              Boq[]
  auditEvents       AuditEvent[]
  @@map("organizations")
}

model Membership {
  id             String       @id @db.Uuid
  userId         String       @db.Uuid @map("user_id")
  organizationId String       @db.Uuid @map("organization_id")
  roles          String[]
  createdAt      DateTime     @default(now()) @map("created_at")
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model ContractorProfile {
  id                       String           @id @db.Uuid
  organizationId           String           @unique @db.Uuid @map("organization_id")
  legalName                String           @map("legal_name")
  commercialRegistrationNo String           @map("commercial_registration_no")
  city                     String?
  phone                    String?
  status                   ContractorStatus @default(DRAFT)
  trialStartedAt           DateTime?        @map("trial_started_at")
  trialEndsAt              DateTime?        @map("trial_ends_at")
  createdAt                DateTime         @default(now()) @map("created_at")
  updatedAt                DateTime         @updatedAt @map("updated_at")
  organization             Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([status])
  @@map("contractor_profiles")
}

model Project {
  id                String        @id @db.Uuid
  organizationId    String        @db.Uuid @map("organization_id")
  name              String
  clientName        String        @map("client_name")
  city              String
  scope             String
  estimatedValue    Decimal?      @db.Decimal(14,2) @map("estimated_value")
  expectedStartDate DateTime?     @db.Date @map("expected_start_date")
  status            ProjectStatus @default(DRAFT)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  documents         Document[]
  boqs              Boq[]
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("projects")
}

model Document {
  id             String         @id @db.Uuid
  organizationId String         @db.Uuid @map("organization_id")
  projectId      String         @db.Uuid @map("project_id")
  type           String
  title          String
  currentVersion Int            @default(1) @map("current_version")
  status         DocumentStatus @default(UPLOADED)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  versions       DocumentVersion[]
  @@index([organizationId, projectId])
  @@map("documents")
}

model DocumentVersion {
  id         String   @id @db.Uuid
  documentId String   @db.Uuid @map("document_id")
  version    Int
  fileName   String   @map("file_name")
  mimeType   String   @map("mime_type")
  sizeBytes  BigInt   @map("size_bytes")
  sha256     String   @db.Char(64)
  storageKey String   @map("storage_key")
  createdAt  DateTime @default(now()) @map("created_at")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  @@unique([documentId, version])
  @@index([sha256])
  @@map("document_versions")
}

model AuditEvent {
  id             String        @id @db.Uuid
  event          String
  actorId        String?       @db.Uuid @map("actor_id")
  organizationId String        @db.Uuid @map("organization_id")
  entityType     String        @map("entity_type")
  entityId       String        @db.Uuid @map("entity_id")
  requestId      String        @map("request_id")
  occurredAt     DateTime      @default(now()) @map("occurred_at")
  metadata       Json          @default("{}")
  actor          User?         @relation("ActorAuditEvents", fields: [actorId], references: [id], onDelete: SetNull)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId, entityType, entityId, occurredAt])
  @@index([requestId])
  @@map("audit_events")
}

model Boq {
  id             String    @id @db.Uuid
  organizationId String    @db.Uuid @map("organization_id")
  projectId      String    @db.Uuid @map("project_id")
  title          String
  currentVersion Int       @default(1) @map("current_version")
  status         BoqStatus @default(DRAFT)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  versions       BoqVersion[]
  @@index([organizationId, projectId])
  @@map("boqs")
}

model BoqVersion {
  id           String    @id @db.Uuid
  boqId        String    @db.Uuid @map("boq_id")
  version      Int
  status       BoqStatus @default(DRAFT)
  changeReason String?   @map("change_reason")
  submittedAt  DateTime? @map("submitted_at")
  approvedAt   DateTime? @map("approved_at")
  approvedBy   String?   @db.Uuid @map("approved_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  boq          Boq       @relation(fields: [boqId], references: [id], onDelete: Restrict)
  items        BoqItem[]
  @@unique([boqId, version])
  @@map("boq_versions")
}

model BoqItem {
  id          String   @id @db.Uuid
  versionId   String   @db.Uuid @map("version_id")
  lineNo      Int      @map("line_no")
  itemCode    String?  @map("item_code")
  description String
  category    String?
  manufacturer String?
  model       String?
  unit        String
  quantity    Decimal  @db.Decimal(14,3)
  unitPrice   Decimal? @db.Decimal(14,2) @map("unit_price")
  specification String?
  createdAt   DateTime @default(now()) @map("created_at")
  version     BoqVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  @@unique([versionId, lineNo])
  @@index([versionId])
  @@map("boq_items")
}

enum ProcurementStatus { DRAFT SUBMITTED APPROVED REJECTED CLOSED }
enum RfqStatus { DRAFT ISSUED CLOSED AWARDED CANCELLED }
enum SupplierQuoteStatus { DRAFT SUBMITTED SELECTED REJECTED }
enum PurchaseOrderStatus { DRAFT APPROVED PARTIALLY_DELIVERED FULLY_DELIVERED CLOSED CANCELLED }
enum DeliveryStatus { EXPECTED ARRIVED UNDER_INSPECTION PARTIALLY_ACCEPTED ACCEPTED REJECTED }
enum InventoryMovementType { PURCHASE_RECEIPT PROJECT_ALLOCATION PROJECT_ISSUE PROJECT_RETURN SUPPLIER_RETURN WAREHOUSE_TRANSFER ADJUSTMENT }

model Supplier {
  id String @id @db.Uuid
  organizationId String @db.Uuid @map("organization_id")
  name String
  taxNumber String? @map("tax_number")
  email String?
  phone String?
  createdAt DateTime @default(now()) @map("created_at")
  @@index([organizationId, name])
  @@map("suppliers")
}
model MaterialRequirement {
  id String @id @db.Uuid
  organizationId String @db.Uuid @map("organization_id")
  projectId String @db.Uuid @map("project_id")
  boqVersionId String @db.Uuid @map("boq_version_id")
  status ProcurementStatus @default(DRAFT)
  requestedBy String? @db.Uuid @map("requested_by")
  createdAt DateTime @default(now()) @map("created_at")
  items MaterialRequirementItem[]
  rfqs Rfq[]
  @@index([organizationId, projectId])
  @@map("material_requirements")
}
model MaterialRequirementItem {
  id String @id @db.Uuid
  materialRequirementId String @db.Uuid @map("material_requirement_id")
  boqItemId String @db.Uuid @map("boq_item_id")
  quantity Decimal @db.Decimal(14,3)
  requirement MaterialRequirement @relation(fields:[materialRequirementId], references:[id], onDelete:Restrict)
  @@unique([materialRequirementId, boqItemId])
  @@map("material_requirement_items")
}
model Rfq {
  id String @id @db.Uuid
  organizationId String @db.Uuid @map("organization_id")
  projectId String @db.Uuid @map("project_id")
  materialRequirementId String @db.Uuid @map("material_requirement_id")
  status RfqStatus @default(DRAFT)
  dueAt DateTime? @map("due_at")
  createdAt DateTime @default(now()) @map("created_at")
  requirement MaterialRequirement @relation(fields:[materialRequirementId], references:[id], onDelete:Restrict)
  quotes SupplierQuote[]
  @@index([organizationId, projectId])
  @@map("rfqs")
}
model SupplierQuote {
  id String @id @db.Uuid
  rfqId String @db.Uuid @map("rfq_id")
  supplierId String @db.Uuid @map("supplier_id")
  status SupplierQuoteStatus @default(DRAFT)
  currency String @default("SAR")
  leadTimeDays Int? @map("lead_time_days")
  paymentTerms String? @map("payment_terms")
  submittedAt DateTime? @map("submitted_at")
  createdAt DateTime @default(now()) @map("created_at")
  rfq Rfq @relation(fields:[rfqId], references:[id], onDelete:Restrict)
  items SupplierQuoteItem[]
  @@unique([rfqId, supplierId])
  @@map("supplier_quotes")
}
model SupplierQuoteItem {
  id String @id @db.Uuid
  supplierQuoteId String @db.Uuid @map("supplier_quote_id")
  boqItemId String @db.Uuid @map("boq_item_id")
  quantity Decimal @db.Decimal(14,3)
  unitPrice Decimal @db.Decimal(14,2) @map("unit_price")
  availableQty Decimal? @db.Decimal(14,3) @map("available_qty")
  quote SupplierQuote @relation(fields:[supplierQuoteId], references:[id], onDelete:Restrict)
  @@unique([supplierQuoteId, boqItemId])
  @@map("supplier_quote_items")
}
model PurchaseOrder {
  id String @id @db.Uuid
  organizationId String @db.Uuid @map("organization_id")
  projectId String @db.Uuid @map("project_id")
  supplierId String @db.Uuid @map("supplier_id")
  supplierQuoteId String? @db.Uuid @map("supplier_quote_id")
  poNumber String @map("po_number")
  status PurchaseOrderStatus @default(DRAFT)
  approvedAt DateTime? @map("approved_at")
  createdAt DateTime @default(now()) @map("created_at")
  items PurchaseOrderItem[]
  deliveries Delivery[]
  @@unique([organizationId, poNumber])
  @@index([organizationId, projectId, status])
  @@map("purchase_orders")
}
model PurchaseOrderItem {
  id String @id @db.Uuid
  purchaseOrderId String @db.Uuid @map("purchase_order_id")
  boqItemId String? @db.Uuid @map("boq_item_id")
  description String
  unit String
  quantity Decimal @db.Decimal(14,3)
  unitPrice Decimal @db.Decimal(14,2) @map("unit_price")
  purchaseOrder PurchaseOrder @relation(fields:[purchaseOrderId], references:[id], onDelete:Restrict)
  deliveryItems DeliveryItem[]
  @@map("purchase_order_items")
}
model Delivery {
  id String @id @db.Uuid
  organizationId String @db.Uuid @map("organization_id")
  projectId String @db.Uuid @map("project_id")
  purchaseOrderId String @db.Uuid @map("purchase_order_id")
  deliveryNumber String @map("delivery_number")
  status DeliveryStatus @default(EXPECTED)
  arrivedAt DateTime? @map("arrived_at")
  receivedAt DateTime? @map("received_at")
  createdAt DateTime @default(now()) @map("created_at")
  purchaseOrder PurchaseOrder @relation(fields:[purchaseOrderId], references:[id], onDelete:Restrict)
  items DeliveryItem[]
  @@unique([organizationId, deliveryNumber])
  @@map("deliveries")
}
model DeliveryItem {
  id String @id @db.Uuid
  deliveryId String @db.Uuid @map("delivery_id")
  purchaseOrderItemId String @db.Uuid @map("purchase_order_item_id")
  arrivedQty Decimal @db.Decimal(14,3) @map("arrived_qty")
  acceptedQty Decimal @default(0) @db.Decimal(14,3) @map("accepted_qty")
  rejectedQty Decimal @default(0) @db.Decimal(14,3) @map("rejected_qty")
  damagedQty Decimal @default(0) @db.Decimal(14,3) @map("damaged_qty")
  delivery Delivery @relation(fields:[deliveryId], references:[id], onDelete:Restrict)
  purchaseOrderItem PurchaseOrderItem @relation(fields:[purchaseOrderItemId], references:[id], onDelete:Restrict)
  @@unique([deliveryId, purchaseOrderItemId])
  @@map("delivery_items")
}
model Warehouse {
  id String @id @db.Uuid
  organizationId String @db.Uuid @map("organization_id")
  name String
  city String?
  createdAt DateTime @default(now()) @map("created_at")
  @@index([organizationId, name])
  @@map("warehouses")
}
model InventoryMovement {
  id String @id @db.Uuid
  organizationId String @db.Uuid @map("organization_id")
  warehouseId String @db.Uuid @map("warehouse_id")
  projectId String? @db.Uuid @map("project_id")
  boqItemId String? @db.Uuid @map("boq_item_id")
  movementType InventoryMovementType @map("movement_type")
  quantity Decimal @db.Decimal(14,3)
  unitCost Decimal? @db.Decimal(14,2) @map("unit_cost")
  referenceType String @map("reference_type")
  referenceId String @db.Uuid @map("reference_id")
  occurredAt DateTime @default(now()) @map("occurred_at")
  @@index([organizationId, warehouseId, occurredAt])
  @@index([organizationId, projectId, occurredAt])
  @@map("inventory_movements")
}
